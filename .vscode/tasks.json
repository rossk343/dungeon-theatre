{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend (API)",
      "type": "shell",
      "command": "dotnet run --no-launch-profile --urls http://localhost:5092",
      "options": { "cwd": "${workspaceFolder}/server/DungeonTheatre.Api" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev", "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/client" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev", "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Start Dungeon Theatre",
      "dependsOn": ["Backend (API)", "Frontend (Vite)"],
      "dependsOrder": "parallel",
      "runOptions": { "runOn": "folderOpen" },
      "problemMatcher": []
    }
  ]
}
